# =============================================================================
# GymManager — modelo de variáveis de ambiente
# IC: GYM-CFG-002 · Versão 0.1.1 · Responsável: DBA/DevOps (João Vitor Simonetti)
#
# Como usar:  cp .env.example .env   e troque TODOS os valores "trocar-..."
# O arquivo .env NUNCA é versionado (ver .gitignore e RNF03).
# =============================================================================

# --- Banco de dados (MySQL) --------------------------------------------------
MYSQL_HOST=db
MYSQL_PORT=3306
MYSQL_DATABASE=gymmanager
MYSQL_USER=gymmanager
MYSQL_PASSWORD=trocar-senha-do-banco
MYSQL_ROOT_PASSWORD=trocar-senha-root-do-banco

# --- Backend (Flask) ---------------------------------------------------------
# Chave usada pelo Flask; gere uma com:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=trocar-chave-secreta
# Validade da sessão (token de acesso), em horas
SESSAO_HORAS=8
# Origens autorizadas a chamar a API diretamente (separadas por vírgula).
# Vazio = somente a mesma origem (o frontend acessa a API via proxy em /api).
CORS_ORIGENS=

# --- Usuário administrador inicial (ERS 2.6) ---------------------------------
# Criado na primeira subida se ainda não existir nenhum administrador.
# Senha: mínimo de 8 caracteres, com letras e números.
ADMIN_NOME=Administrador
ADMIN_EMAIL=admin@gymmanager.local
ADMIN_SENHA=trocar-senha-admin1

# --- Portas publicadas no host (docker-compose) -----------------------------
FRONTEND_PORTA=8080
BACKEND_PORTA=5000
MYSQL_PORTA_HOST=3316
