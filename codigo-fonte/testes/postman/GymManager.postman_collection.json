{
  "info": {
    "name": "GymManager — API v1 (GYM-TST-004)",
    "description": "IC GYM-TST-004 · Plano de Testes (GYM-TST-001), seção 3.3. Fluxo completo da API pelo proxy do frontend. Variáveis fornecidas pelo CI: baseUrl, adminEmail, adminSenha. Toda requisição verifica tempo de resposta < 2000 ms (RNF04).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test(\"RNF04 — resposta em menos de 2000 ms\", () => pm.expect(pm.response.responseTime).to.be.below(2000));"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/api/v1"
    },
    {
      "key": "adminEmail",
      "value": ""
    },
    {
      "key": "adminSenha",
      "value": ""
    },
    {
      "key": "sufixo",
      "value": ""
    },
    {
      "key": "tokenAdmin",
      "value": ""
    },
    {
      "key": "tokenInstrutor",
      "value": ""
    },
    {
      "key": "tokenAluno",
      "value": ""
    },
    {
      "key": "alunoId",
      "value": ""
    },
    {
      "key": "exercicioId",
      "value": ""
    },
    {
      "key": "fichaId",
      "value": ""
    },
    {
      "key": "itemId",
      "value": ""
    },
    {
      "key": "execucaoId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 Login do administrador (RF02)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set(\"sufixo\", Date.now().toString(36));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
              "const d = pm.response.json();",
              "pm.test(\"Perfil ADMIN e token\", () => { pm.expect(d.usuario.perfil).to.eql(\"ADMIN\"); pm.expect(d.token).to.be.a(\"string\"); });",
              "pm.collectionVariables.set(\"tokenAdmin\", d.token);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"senha\": \"{{adminSenha}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "02 Admin cadastra instrutor (RF06, RN03)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
              "pm.test(\"Perfil INSTRUTOR\", () => pm.expect(pm.response.json().perfil).to.eql(\"INSTRUTOR\"));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{tokenAdmin}}"
          }
        ],
        "url": "{{baseUrl}}/usuarios",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nome\": \"Instrutor Newman\",\n  \"email\": \"instrutor-{{sufixo}}@newman.local\",\n  \"senha\": \"Senha1234\",\n  \"perfil\": \"INSTRUTOR\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "03 Login do instrutor",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set(\"tokenInstrutor\", pm.response.json().token);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"instrutor-{{sufixo}}@newman.local\",\n  \"senha\": \"Senha1234\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "04 Instrutor cadastra aluno (RF01)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set(\"alunoId\", pm.response.json().id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{tokenInstrutor}}"
          }
        ],
        "url": "{{baseUrl}}/alunos",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nome\": \"Aluno Newman\",\n  \"email\": \"aluno-{{sufixo}}@newman.local\",\n  \"senha\": \"Senha1234\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "05 Instrutor cadastra exercício (RF03)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set(\"exercicioId\", pm.response.json().id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{tokenInstrutor}}"
          }
        ],
        "url": "{{baseUrl}}/exercicios",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nome\": \"Supino Newman {{sufixo}}\",\n  \"grupo_muscular\": \"Peito\",\n  \"descricao\": \"Criado pela coleção Newman\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "06 Instrutor cria ficha para o aluno (RF04, RN01, RN06)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
              "const f = pm.response.json();",
              "pm.test(\"Ficha vigente com 1 exercício\", () => { pm.expect(f.vigente).to.be.true; pm.expect(f.exercicios).to.have.lengthOf(1); });",
              "pm.collectionVariables.set(\"fichaId\", f.id);",
              "pm.collectionVariables.set(\"itemId\", f.exercicios[0].id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{tokenInstrutor}}"
          }
        ],
        "url": "{{baseUrl}}/fichas",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nome\": \"Treino A Newman\",\n  \"aluno_id\": {{alunoId}},\n  \"data_inicio\": \"2026-01-01\",\n  \"exercicios\": [\n    {\n      \"exercicio_id\": {{exercicioId}},\n      \"series\": 3,\n      \"repeticoes\": 12,\n      \"carga_kg\": 20,\n      \"descanso_s\": 60\n    }\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "07 Login do aluno",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set(\"tokenAluno\", pm.response.json().token);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"aluno-{{sufixo}}@newman.local\",\n  \"senha\": \"Senha1234\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "08 Aluno consulta a própria ficha (RF04, RN02)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Ficha do próprio aluno\", () => pm.expect(pm.response.json().aluno.id).to.eql(Number(pm.collectionVariables.get(\"alunoId\"))));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{tokenAluno}}"
          }
        ],
        "url": "{{baseUrl}}/fichas/{{fichaId}}"
      }
    },
    {
      "name": "09 Aluno não cria ficha (RN01)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 403 — acesso negado\", () => pm.response.to.have.status(403));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{tokenAluno}}"
          }
        ],
        "url": "{{baseUrl}}/fichas",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nome\": \"Indevida\",\n  \"aluno_id\": {{alunoId}},\n  \"data_inicio\": \"2026-01-01\",\n  \"exercicios\": [\n    {\n      \"exercicio_id\": {{exercicioId}},\n      \"series\": 3,\n      \"repeticoes\": 10\n    }\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "10 Aluno inicia a execução (RF05, RN07, RN10)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set(\"execucaoId\", pm.response.json().id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{tokenAluno}}"
          }
        ],
        "url": "{{baseUrl}}/execucoes",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"ficha_id\": {{fichaId}}\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "11 Aluno registra o exercício (RF05)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
              "pm.test(\"1 registro\", () => pm.expect(pm.response.json().registros).to.have.lengthOf(1));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{tokenAluno}}"
          }
        ],
        "url": "{{baseUrl}}/execucoes/{{execucaoId}}/exercicios",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"ficha_exercicio_id\": {{itemId}},\n  \"repeticoes\": 12,\n  \"carga_kg\": 22.5\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "12 Aluno finaliza a execução (RF05)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Execução com fim\", () => pm.expect(pm.response.json().fim).to.not.be.null);"
            ]
          }
        }
      ],
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{tokenAluno}}"
          }
        ],
        "url": "{{baseUrl}}/execucoes/{{execucaoId}}/finalizar"
      }
    },
    {
      "name": "13 Execução finalizada não aceita registro (RN11)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 409 — conflito\", () => pm.response.to.have.status(409));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{tokenAluno}}"
          }
        ],
        "url": "{{baseUrl}}/execucoes/{{execucaoId}}/exercicios",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"ficha_exercicio_id\": {{itemId}},\n  \"repeticoes\": 10,\n  \"carga_kg\": 20\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "14 Aluno consulta o histórico (RF05)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
              "const h = pm.response.json();",
              "pm.test(\"Histórico com execução e evolução de carga\", () => { pm.expect(h.execucoes.length).to.be.at.least(1); pm.expect(h.evolucao[0].pontos[0].carga_kg).to.eql(22.5); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{tokenAluno}}"
          }
        ],
        "url": "{{baseUrl}}/alunos/{{alunoId}}/historico"
      }
    },
    {
      "name": "15 Rota protegida sem token (RNF02)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 401\", () => pm.response.to.have.status(401));"
            ]
          }
        }
